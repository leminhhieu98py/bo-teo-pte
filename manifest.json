{
  "manifest_version": 3,
  "name": "Bo cố lên",
  "version": "1.0.0",
  "description": "Save English words with one shortcut and review them every day with Mochi.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bo cố lên",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "scripting", "activeTab", "contextMenus", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "save-word": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "Save the selected word to Bo cố lên"
    }
  }
}
